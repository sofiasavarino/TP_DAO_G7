# API key de Google Books. Completá en .env o exportala en tu shell.
GOOGLE_BOOKS_API_KEY=

# Base de datos — por defecto sqlite local en biblioteca.db
DATABASE_URL=sqlite:///biblioteca.db

# JWT — completar con un random largo para producción (p. ej. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Email — `console` lo loguea; `gmail` lo manda por SMTP real. Credenciales de la cuenta de pruebas.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
